        "jsCode": "const raw = String($json.stdout || $json.data || $json.output || '').trim();\nif (!raw) {\n  throw new Error('Instagram image upload returned empty response');\n}\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (error) {\n  throw new Error('Instagram image upload returned non-JSON response: ' + raw.slice(0, 300));\n}\nif (!parsed.success || !Array.isArray(parsed.files) || !parsed.files[0]?.url) {\n  throw new Error('Instagram image upload failed: ' + raw.slice(0, 500));\n}\nconst imageUrl = String(parsed.files[0].url);\nconst qa = $('Code in JavaScript1').first().json;\nconst question = String(qa.questionBlock || '').split('\\n')[0] || 'BCBA Mock Question';\nconst caption = 'BCBA Mock Question in 60 Seconds\\n\\n' + question + '\\n\\nMore free BCBA mock exams: https://bcbamockexam.com/free-bcba-mock-exam';\nreturn [{\n  json: {\n    imageUrl,\n    uploadedFileName: parsed.files[0].filename,\n    uploadedSize: parsed.files[0].size,\n    question,\n    caption,\n    altText: 'BCBA mock exam question graphic'\n  }\n}];"
