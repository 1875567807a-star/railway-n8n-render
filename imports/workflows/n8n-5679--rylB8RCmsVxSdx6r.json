      "id": "aa18e3ba-d410-4b1d-9bb3-5470db04f71f",
      "name": "Shorts Generator",
      "webhookId": "47968525-5361-49f9-8cc5-3fc64bb62dda"
    },
    {
      "parameters": {
        "jsCode": "/**\n * 输入：HTTP Request（1 item）\n * {\n *   runDir,\n *   files: [\"cover.png\",\"page-1.png\",\"page-2.png\",\"page-3.png\"]\n * }\n *\n * 输出：每一页一个 item（不含 cover）\n */\n\nconst httpItem = items[0].json;\nconst runDir = httpItem.runDir;\nconst files = httpItem.files || [];\n\nconst results = [];\n\nfiles.forEach((file) => {\n  if (!file.startsWith('page-')) return; // 跳过 cover\n\n  const match = file.match(/page-(\\d+)\\.png/);\n  if (!match) return;\n\n  const page = Number(match[1]);\n\n  results.push({\n    json: {\n      page,\n      imagePath: `${runDir}/${file}`\n    }\n  });\n});\n\nreturn results;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        1200
      ],
      "id": "f4296445-abf8-4aab-a062-3abf28187dd8",
      "name": "Code in JavaScript5"
    },
    {
      "parameters": {
        "jsCode": "// ⚠️ 这里的 runId 以后可以动态，现在先用已有的\nconst runId = $('HTTP Request').first().json.runDir;\n\nreturn [\n  {\n    json: {\n      runId,\n\n      // renderer 已有的图片目录（不改 renderer）\n      imageDir: `${runId}`,\n\n      // mp3 已经写入的目录（你现在就在用）\n      audioDir: `/data`,\n\n      // ffmpeg 最终统一工作目录\n      runDir: `/data/${runId}`\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4752,
        1328
      ],
      "id": "5aade8bd-c265-4a80-81fa-8753cdb66405",
      "name": "Code in JavaScript6"
    },
    {
      "parameters": {
        "command": "=sh -lc '\nset -e\n\nIMGDIR=\"{{$json.imageDir}}\"\nRUNDIR=\"{{$json.runDir}}\"\n\nmkdir -p \"$RUNDIR\"\n\necho \"== copy images ==\"\ncp \"$IMGDIR\"/*.png \"$RUNDIR\"/\n\necho \"== 1. cover.mp4 (2s silent) ==\"\nffmpeg -y \\\n  -loop 1 -i \"$RUNDIR/cover.png\" \\\n  -f lavfi -i anullsrc=channel_layout=mono:sample_rate=22050 \\\n  -t 2 \\\n  -vf \"scale=ceil(iw/2)*2:ceil(ih/2)*2\" \\\n  -c:v libx264 -pix_fmt yuv420p -r 30 \\\n  -c:a aac \\\n  \"$RUNDIR/cover.mp4\"\n\necho \"== 2. page videos ==\"\nfor img in \"$RUNDIR\"/page-*.png; do\n  name=$(basename \"$img\" .png)\n  audio=\"/data/${name}.mp3\"\n  out=\"$RUNDIR/${name}.mp4\"\n\n  echo \"Rendering $out\"\n  ffmpeg -y \\\n    -loop 1 -i \"$img\" \\\n    -i \"$audio\" \\\n    -vf \"scale=ceil(iw/2)*2:ceil(ih/2)*2\" \\\n    -c:v libx264 -pix_fmt yuv420p -r 30 \\\n    -c:a aac -b:a 128k \\\n    -shortest \\\n    \"$out\"\ndone\n\necho \"== 3. write concat list ==\"\nprintf \"file '\\''%s/cover.mp4'\\''\\n\" \"$RUNDIR\" > \"$RUNDIR/list.txt\"\n\nfor f in \"$RUNDIR\"/page-*.mp4; do\n  printf \"file '\\''%s'\\''\\n\" \"$f\" >> \"$RUNDIR/list.txt\"\ndone\n\ncat \"$RUNDIR/list.txt\"\n\necho \"== 4. concat final.mp4 ==\"\nffmpeg -y \\\n  -f concat -safe 0 \\\n  -i \"$RUNDIR/list.txt\" \\\n  -c copy \\\n  \"$RUNDIR/final.mp4\"\n\necho \"== DONE ==\"\nls -lh \"$RUNDIR\"\n'\n"
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        4960,
        1328
      ],
      "id": "daa37db5-b045-4132-844c-d0a37ba9b91a",
