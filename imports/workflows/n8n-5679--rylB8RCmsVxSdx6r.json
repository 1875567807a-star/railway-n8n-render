    {
      "parameters": {
        "jsCode": "/**\n * Code in JavaScript7\n * Mode: Run Once for All Items\n *\n * 作用：\n * - 从 AI Agent 的 output 中拆 Page\n * - 每一页生成一个 item\n * - 给每一条 text 补上 page（用于 Merge）\n */\n\n// 1️⃣ 拿 AI Agent 的完整输出\nconst fullText = $json.output;\nif (!fullText || typeof fullText !== 'string') {\n  throw new Error('❌ AI Agent 没有返回有效的 output');\n}\n\n// 2️⃣ 按 [Page X] 拆分（丢掉封面）\nconst pages = fullText\n  .split(/\\n\\s*\\[Page \\d+\\]/)\n  .slice(1);\n\n// 3️⃣ 提取每页 Content，并补 page\nconst results = pages\n  .map((pageText, index) => {\n    const match = pageText.match(/Content:\\s*([\\s\\S]*)/);\n\n    return {\n      json: {\n        page: index + 1,                 // ⭐ 关键：补 page\n        text: match ? match[1].trim() : ''\n      }\n    };\n  })\n  .filter(item => item.json.text.length > 0);\n\n// 4️⃣ 每页一个 item\nreturn results;\n"
      },
