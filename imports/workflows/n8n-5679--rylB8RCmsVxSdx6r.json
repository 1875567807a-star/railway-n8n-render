    {
      "parameters": {
        "jsCode": "// 1️⃣ 只取一个 voice（Find Voice ID 一定是 1 item）\nconst voice = $items(\"Find Voice ID\")[0].json;\n\n// 2️⃣ 取每一页真正的文本（来自 Code in JavaScript4）\nconst pages = $items(\"Code in JavaScript4\");\n\nreturn pages.map(item => ({\n  json: {\n    // ✅ TTS 真正朗读的文本（唯一来源）\n    text: item.json.text,\n\n    // ✅ ElevenLabs 必须的 voice\n    voice_id: voice.voice_id,\n    voice_name: voice.voice_name,\n\n    // （可选）保留这些，方便你后面 ffmpeg 用\n    pageIndex: item.json.pageIndex,\n    imagePath: item.json.imagePath,\n    audioPath: item.json.audioPath\n  }\n}));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3760,
        1328
      ],
      "id": "d3f58ca3-2304-4a5f-9ec5-7eab73860c4b",
      "name": "Code in JavaScript3"
    },
    {
      "parameters": {
        "jsCode": "/**\n * Code in JavaScript4\n * Mode: Run Once for All Items\n *\n * 输入（来自 Merge）：\n * {\n *   page,\n *   imagePath,\n *   text\n * }\n *\n * 输出：\n * {\n *   page,\n *   imagePath,\n *   text,\n *   audioFile\n * }\n */\n\nif (!items.length) {\n  throw new Error('❌ No merged items received');\n}\n\nconst results = items.map(item => {\n  const { page, imagePath, text } = item.json;\n\n  if (!page || !imagePath || !text) {\n    throw new Error(`❌ Missing data on page ${page}`);\n  }\n\n  return {\n    json: {\n      page,\n      imagePath,\n      text,\n      audioFile: `page-${page}.mp3`\n    }\n  };\n});\n\nreturn results;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2592,
        1312
      ],
      "id": "79ecdd0d-d4e2-4502-807d-43e03eaad6ef",
      "name": "Code in JavaScript4"
    },
    {
      "parameters": {
        "jsCode": "return items.map((item, index) => {\n  const pageIndex = index + 1;\n  const runDir = item.json.runDir; // ✅ 从当前 item 读\n\n  return {\n    json: {\n      pageIndex,\n      imagePath: `${runDir}/page-${pageIndex}.png`,\n      audioPath: `/data/page-${pageIndex}.mp3`\n    },\n    binary: {\n      audio: item.binary.audio // ⭐ 音频继续往下带\n    }\n  };\n});\n"
      },
